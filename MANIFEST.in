# Include templates and static assets
recursive-include hostvigil/dashboard/templates *.html
recursive-include hostvigil/dashboard/static *
recursive-include hostvigil/stealth_configs *.yaml

# Include config and docs
include config.yaml
include entp_config.yaml
include requirements.txt
include LICENSE
include README.md
include install.sh
include install.ps1

# Include plugin example
recursive-include plugins *.py

# Exclude dev/runtime artifacts
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
prune data
prune venv
prune .kiro
prune .github
